# Copy to .env for local runs. .env is git-ignored.
# Nothing is needed for the default provider (company): it uses the login `ada cc` saved on this Mac.

# provider: anthropic
# ANTHROPIC_API_KEY=

# provider: gemini (Google blocks it from mainland China)
# GEMINI_API_KEY=

# Run the model step by hand instead (see README, "Running without a key").
# RADAR_LLM=manual
